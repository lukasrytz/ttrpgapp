{
  "name": "ttrpgapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "plugins/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "build-srd": "npm run build-srd -w @ttrpgapp/plugin-dnd5e",
    "autotag": "npm run autotag -w @ttrpgapp/server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
